rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ---------------------------------------------------------
    // 1. GLOBAL SAFETY NET & HELPERS
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role-based helper (explicit check)
    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---------------------------------------------------------
    // 2. ENTITY VALIDATORS
    // ---------------------------------------------------------

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'stock']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category in ['Essentials', 'Accessories', 'Footwear', 'Streetwear'] &&
             data.stock is number && data.stock >= 0 &&
             (!data.keys().contains('description') || (data.description is string && data.description.size() <= 2000)) &&
             (!data.keys().contains('images') || (data.images is list && data.images.size() <= 10)) &&
             (!data.keys().contains('createdAt') || data.createdAt is timestamp);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'customer'] &&
             (!data.keys().contains('displayName') || (data.displayName is string && data.displayName.size() <= 100));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'totalAmount', 'status']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['pending', 'shipped', 'delivered', 'cancelled'] &&
             (!data.keys().contains('createdAt') || data.createdAt == request.time);
    }

    // ---------------------------------------------------------
    // 3. MATCH BLOCKS
    // ---------------------------------------------------------

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                    (incoming().role == 'customer' || request.auth.token.email == 'ahmedraza3797863@gmail.com');
      allow update: if (isOwner(userId) && isValidUser(incoming()) && 
                    (incoming().role == existing().role || request.auth.token.email == 'ahmedraza3797863@gmail.com')) || isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && isValidOrder(incoming()) && isValidId(orderId);
      allow update: if isAdmin() && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
                    existing().status != 'delivered' && existing().status != 'cancelled';
    }
  }
}
